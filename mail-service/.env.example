# Переменные окружения почтового сервиса.
#
# Это шаблон: в нём только имена переменных и заглушки, секретов здесь нет.
# В репозиторий он попадает намеренно — по нему настраивают сервер.
#
# На самом сервере задаются в панели хостинга, а не в файле.

# --- Куда подключаться ---

# Gmail или Яндекс. Оба проверены с этого сервера и отвечают живым
# баннером со STARTTLS.
SMTP_HOST=smtp.gmail.com

# 587 — шифрование поднимается после подключения (STARTTLS).
# 465 — шифрование сразу при подключении, тогда SMTP_SECURE=true.
SMTP_PORT=587
SMTP_SECURE=false

# --- Отправитель ---

# Адрес ящика, с которого отправляем.
SMTP_USER=noreply@example.com

# ПАРОЛЬ ПРИЛОЖЕНИЯ, а не пароль ящика. Основной пароль по SMTP не
# принимается. Получить: в аккаунте Google или Яндекса включить
# двухэтапную аутентификацию, затем в настройках безопасности выпустить
# пароль приложения для почты.
SMTP_PASS=ВСТАВЬТЕ_ПАРОЛЬ_ПРИЛОЖЕНИЯ

# Что писать в поле «От». Обычно совпадает с SMTP_USER.
MAIL_FROM="ИБ-Гид <noreply@example.com>"

# --- Страница проверки отправки ---

# Токен для страницы проверки: https://<поддомон>/?key=<токен>
# Если не задать, сервис придумает его при старте и напечатает в консоль,
# и он сменится при каждом перезапуске.
TEST_TOKEN=придумайте-любую-длинную-строку

# Адрес, который подставляется в поле «кому». На странице его можно
# стереть и вписать любой другой — это только значение по умолчанию.
TEST_TO=noreply@example.com

# --- Прочее ---

# Порт, назначенный панелью. По умолчанию 11678.
PORT=11678

# Адрес сайта, которому разрешено обращаться к сервису. Без него любой
# сайт сможет слать письма от вашего имени.
ALLOWED_ORIGIN=https://normalguy123412-design.github.io