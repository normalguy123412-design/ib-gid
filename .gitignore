# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
#
# Собран из двух шаблонов репозитория github/gitignore: Nextjs и Node.
# Строки шаблонов не переписывались — так файл остаётся сравнимым с
# оригиналом, а обновление шаблона видно построчно. Ниже к ним добавлены
# правила этого проекта, и у каждого написано, зачем оно.
#
# Из шаблона Node намеренно не взяты разделы про чужие сборщики (Nuxt,
# Gatsby, VuePress, Tauri) — в проекте их нет, а лишние строки в этом
# файле опасны тем, что их перестают читать.

# dependencies
# Без ведущего слэша: правило со слэшем действует только в корне, и
# node_modules внутри mail-service/ уехал бы в репозиторий целиком.
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
.nyc_output
*.lcov

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
Desktop.ini
*.pem
*.tgz

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
pids
*.pid
*.seed
*.pid.lock

# кэши инструментов
.npm
.eslintcache
.stylelintcache
.cache
.parcel-cache
.node_repl_history

# env files (can opt-in for committing if needed)
# Секреты — .env и его варианты. Шаблон .env.example перечисляет только
# имена переменных и заглушки, секретов в нём нет, и без исключения
# он молча не коммитился бы: шаблон нужен другим людям и при развёртывании.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# next dev дописывает этот файл сам и обновляет его при каждом запуске,
# поэтому в репозитории он только мешал бы: каждая правка кода тянула бы
# за собой ещё и правку служебного файла.
AGENTS.md
